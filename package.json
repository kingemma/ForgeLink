{
  "name": "forge-link",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeLink - 轻量级车间控制器：局域网设备自动发现、协议自动识别、运行状态监测与多设备工作流编排",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "build": "vite build",
    "start": "electron .",
    "sim": "node src/main/simulator/cli.js",
    "test": "node --test test/*.test.js",
    "test:ui": "vitest run",
    "test:all": "npm run test && npm run test:ui"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "jsdom": "^29.1.1",
    "vite": "^6.0.5",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.3"
  }
}
